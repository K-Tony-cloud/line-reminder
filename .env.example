# ── LINE Bot ─────────────────────────────────────────────────────────────────
# https://developers.line.biz/console/ → channel → Messaging API tab
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_CHANNEL_SECRET=your_channel_secret_here

# ── Google Sheets ─────────────────────────────────────────────────────────────
# Spreadsheet ID from URL: https://docs.google.com/spreadsheets/d/<ID>/
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# LOCAL ONLY — path to service account JSON file
GOOGLE_CREDENTIALS_FILE=credentials/service_account.json

# Optional: separate spreadsheet for daily midnight backups
# GOOGLE_BACKUP_SPREADSHEET_ID=your_backup_spreadsheet_id_here

# RAILWAY / PRODUCTION — paste the entire JSON content of the service account
# key file as a single-line string. When set, this takes priority over the file.
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# ── App settings ──────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000                  # overridden by Railway's PORT env var automatically
DEFAULT_REMINDER_MINUTES=60

# ── Local development ─────────────────────────────────────────────────────────
# Set to "development" to enable hot-reload (not for production)
ENVIRONMENT=production
